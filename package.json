{
  "name": "hr-management-system",
  "version": "1.0.0",
  "description": "Human Resource Management System with Workhours Timetable, Payroll, Leave, and Attendance Management",
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "dev": "npm run build:client && tsx src/server/index.ts",
    "start": "npm run build:client && tsx src/server/index.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
